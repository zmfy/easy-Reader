# 复制本文件为 .env 并按需修改
# docker-compose 会自动读取根目录的 .env 文件

# ── 必填 ──────────────────────────────────────────
# JWT 密钥，生产环境请替换为随机字符串
JWT_SECRET=change-this-to-a-secure-random-string

# ── 可选 ──────────────────────────────────────────
# 服务端口（容器内部端口，对外映射见 docker-compose.yml）
PORT=3000

# 书库目录（容器内路径，宿主机路径在 docker-compose.yml volumes 中配置）
BOOKS_DIR=/app/books

# 数据库目录（容器内路径）
DATA_DIR=/app/data

# 经反向代理（Nginx、Caddy、群晖反代等）访问时，按代理层数识别真实客户端 IP（登录限流按 IP 计数），一层代理填 1
# 直接暴露端口时不要设置，否则客户端可伪造 IP 绕过限流
# TRUST_PROXY=1

# 允许跨域访问 API 的网页来源，逗号分隔（仅运行在其他网址上的网页客户端需要，原生 App 不需要）
# CORS_ORIGINS=https://reader.example.com

# ── 构建镜像源（只影响 docker compose build）────────────
# 不设置时使用官方源；以下为国内源（海外部署请删除或注释掉这三行）
# 基础镜像：DaoCloud 加速的 Docker Hub
NODE_IMAGE=docker.m.daocloud.io/library/node:22-slim
# npm 源：npmmirror（淘宝镜像）
NPM_REGISTRY=https://registry.npmmirror.com
# apt 源：阿里云
DEBIAN_MIRROR=http://mirrors.aliyun.com
